# Server Configuration
PORT=3000
NODE_ENV=development

# WebRTC Configuration
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Socket.io Configuration
SOCKET_PING_INTERVAL=25000
SOCKET_PING_TIMEOUT=60000

# Security & Encryption
JWT_SECRET=your_jwt_secret_key_here_change_in_production_min_32_chars
ENCRYPTION_KEY=your_encryption_key_here_change_in_production_min_32_chars

# HTTPS Configuration
ENABLE_HTTPS=false
SSL_CERT_PATH=/path/to/ssl/cert.pem
SSL_KEY_PATH=/path/to/ssl/key.pem

# Database Configuration (when connecting to MongoDB/Firebase)
MONGODB_URI=mongodb://localhost:27017/lumina-meet
DB_TYPE=mongodb
# Or for Firebase:
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_PRIVATE_KEY=your-private-key
# FIREBASE_CLIENT_EMAIL=your-email

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@luminameet.com

# OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log

# File Storage
STORAGE_TYPE=local
# Or: s3, gcs, azure
MAX_FILE_SIZE_MB=100
UPLOAD_DIR=./uploads

# Session Configuration
SESSION_SECRET=your-session-secret-min-32-chars
SESSION_TIMEOUT_MS=86400000

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Feature Flags
ENABLE_RECORDINGS=false
ENABLE_TRANSCRIPTION=false
ENABLE_2FA=false

